{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true
  },
  "include": [
    "electron.vite.config.ts",
    "src/engine/**/*",
    "src/shared/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/cli/**/*",
    "src/renderer/src/web/session.ts",
    "src/renderer/src/web/request.ts",
    "src/renderer/src/web/store.ts",
    "src/renderer/src/web/device-name.ts",
    "src/renderer/src/web/pair-link.ts",
    "src/renderer/src/web/boot.ts",
    "src/renderer/src/web/menu-model.ts",
    "src/renderer/src/web/dialog-flows.ts",
    "src/renderer/src/phone-nav.ts",
    "src/renderer/src/components/terminal-keys.ts",
    "src/renderer/src/components/composer.ts",
    "src/renderer/src/components/editor-lines.ts",
    "src/renderer/src/components/highlight.ts",
    "src/renderer/src/web/nav-stack.ts",
    "src/renderer/src/web/gestures.ts",
    "tests/**/*"
  ]
}
