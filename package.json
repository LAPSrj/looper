{
  "name": "looper",
  "productName": "Looper",
  "desktopName": "looper.desktop",
  "version": "0.1.6",
  "description": "Cron-style manager for AI agent loops: cheap checks, fresh claude sessions only when there is work, one agent per task.",
  "main": "./out/main/index.js",
  "author": "Leandro Amorim",
  "license": "PolyForm-Strict-1.0.0",
  "private": true,
  "bin": {
    "looper": "./bin/looper.js"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --target=node20 --format=cjs --external:node-pty --outfile=out/cli/cli.js",
    "build:worker": "esbuild src/engine/terminal-worker.ts --bundle --platform=node --target=node20 --format=cjs --outfile=out/cli/terminal-worker.js",
    "build:all": "npm run build && npm run build:cli && npm run build:worker",
    "start": "electron-vite preview",
    "serve": "npm run build:cli && npm run build:worker && node out/cli/cli.js serve",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package": "node scripts/package.js",
    "package:windows": "npm run build:all && electron-builder --win",
    "package:mac": "npm run build:all && electron-builder --mac",
    "package:linux": "npm run build:all && electron-builder --linux",
    "register:notifications": "electron scripts/register-notifications.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "commander": "^13.1.0",
    "croner": "^9.0.0",
    "node-pty": "1.2.0-beta.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.lemorim.looper",
    "npmRebuild": false,
    "productName": "Looper",
    "directories": {
      "buildResources": "assets",
      "output": "release/${os}-${arch}"
    },
    "asarUnpack": [
      "out/main/terminal-worker.js"
    ],
    "files": [
      "out/**",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "fileAssociations": [
        {
          "ext": "loopertask",
          "name": "Looper Task",
          "description": "Looper Task",
          "icon": "assets/loopertask.ico",
          "role": "Editor"
        },
        {
          "ext": "loopertpl",
          "name": "Looper Template",
          "description": "Looper Template",
          "icon": "assets/loopertpl.ico",
          "role": "Editor"
        }
      ]
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "fileAssociations": [
        {
          "ext": "loopertask",
          "name": "Looper Task",
          "description": "Looper Task",
          "role": "Editor"
        },
        {
          "ext": "loopertpl",
          "name": "Looper Template",
          "description": "Looper Template",
          "role": "Editor"
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development",
      "syncDesktopName": true,
      "maintainer": "leandro@lemorim.com",
      "target": [
        "AppImage",
        "deb"
      ],
      "fileAssociations": [
        {
          "ext": "loopertask",
          "name": "Looper Task",
          "description": "Looper Task",
          "role": "Editor"
        },
        {
          "ext": "loopertpl",
          "name": "Looper Template",
          "description": "Looper Template",
          "role": "Editor"
        }
      ]
    }
  }
}
