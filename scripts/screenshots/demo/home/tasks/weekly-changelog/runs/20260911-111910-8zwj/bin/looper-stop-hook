#!/usr/bin/env bash
# generated by looper — Stop-hook gate
payload="$(cat)"
if [ -e '/mnt/c/Users/leand/repos/looper-demo/demo-home/tasks/weekly-changelog/runs/20260911-111910-8zwj/done' ]; then printf '%s' "$payload" > '/mnt/c/Users/leand/repos/looper-demo/demo-home/tasks/weekly-changelog/runs/20260911-111910-8zwj/stop.json'; exit 0; fi
# Emit the background_tasks array up to its real closing ], tracking
# string/escape state and bracket depth, with whitespace outside strings
# dropped — so structural matches cannot hit string contents.
scan_tasks() {
  local rest=$1 out= c i n depth=1 instr=0 esc=0
  n=${#rest}
  for ((i = 0; i < n; i++)); do
    c=${rest:i:1}
    if ((esc)); then esc=0; out+=$c; continue; fi
    if ((instr)); then
      case $c in
      '\') esc=1 ;;
      '"') instr=0 ;;
      esac
      out+=$c
      continue
    fi
    case $c in
    ' ' | $'\t' | $'\n' | $'\r') continue ;;
    '"') instr=1 ;;
    '[' | '{') ((depth++)) ;;
    '}') ((depth--)) ;;
    ']')
      ((depth--))
      if ((depth == 0)); then break; fi
      ;;
    esac
    out+=$c
  done
  printf '%s' "$out"
}
key='"background_tasks":'
rest=${payload#*"$key"}
if [ "$rest" != "$payload" ]; then
  rest="${rest#"${rest%%[![:space:]]*}"}"
  case $rest in
  '['*)
    tasks=$(scan_tasks "${rest#?}")
    case $tasks in
    *'"status":"running"'*) printf '%s\n' '{"decision":"block","reason":"Looper: this unattended session still has background tasks running. Ending the turn ends the session and kills them — no notification can wake you afterwards. Wait for their results now, or stop them if they no longer matter. When the work is done, run looper-done and write your final message."}'; exit 0 ;;
    esac
    ;;
  esac
fi
if [ ! -e '/mnt/c/Users/leand/repos/looper-demo/demo-home/tasks/weekly-changelog/runs/20260911-111910-8zwj/stop-reminded' ]; then
  : > '/mnt/c/Users/leand/repos/looper-demo/demo-home/tasks/weekly-changelog/runs/20260911-111910-8zwj/stop-reminded'
  printf '%s\n' '{"decision":"block","reason":"Looper: the turn ended without looper-done. If the job is finished (or there is nothing to do), run looper-done <status> \"<headline>\" now, then write your final report. If work remains, continue it — nobody is watching this session to nudge you."}'
  exit 0
fi
printf '%s' "$payload" > '/mnt/c/Users/leand/repos/looper-demo/demo-home/tasks/weekly-changelog/runs/20260911-111910-8zwj/stop.json'
exit 0
