    {
      "id": "issue-triage",
      "name": "Issue triage",
      "enabled": true,
      "completion": {
        "allowed": false
      },
      "folderId": "dev",
      "trigger": {
        "mode": "schedule",
        "schedule": {
          "cron": "*/15 * * * *"
        }
      },
      "environmentId": "wsl",
      "cwd": "/home/leandro/looper-demo/webapp",
      "env": {},
      "check": {
        "enabled": true,
        "command": "bash scripts/check-new-issues.sh",
        "timeoutSec": 60
      },
      "classifier": {
        "enabled": true,
        "model": "haiku",
        "prompt": "Decide whether the agent should act now. Say yes only when the items below are real work: new issues that need triage, a label, a reply, or a fix. Ignore bot-filed items, duplicates of known issues, and anything already assigned.\n\nSummary: {{summary}}\n\n{{context}}",
        "mode": "headless",
        "timeoutSec": 180
      },
      "agent": {
        "model": "sonnet",
        "prompt": "Triage the new issue-tracker items below.\n\nSummary: {{summary}}\n\nDetails:\n{{context}}\n\nFor each item: reproduce it if that is quick, label it, answer the reporter, and fix anything that takes under ~20 lines. Commit fixes as you go and mention every issue number in your report.",
        "extraArgs": [],
        "mode": "interactive",
        "session": "fresh",
        "sessionMaxRuns": 10,
        "maxRestarts": 3,
        "permissionMode": "acceptEdits",
        "maxRuntimeMin": 60,
        "idleGraceMin": 3,
        "onIdleTimeout": "finish"
      },
      "backoff": {
        "maxConsecutiveErrors": 5
      },
      "maxConcurrentRuns": 1,
      "notifications": {
        "runStart": false,
        "agentStart": false,
        "end": "warning",
        "held": false,
        "autoPaused": false,
        "completed": false,
        "usageLimit": false,
        "networkErrors": false,
        "environmentErrors": false
      },
      "note": {
        "text": "Also close issues that have been waiting on the reporter for more than 30 days.",
        "runsLeft": 1
      },
      "createdAt": "2026-08-20T17:03:30.134Z"
    },
